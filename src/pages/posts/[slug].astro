---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

type Props = { post: CollectionEntry<"posts"> };

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const author = data.author
    ? (await getCollection("authors")).find((a) => a.data.name === data.author)
    : undefined;

// Liens internes : related_posts contient les slugs Sveltia ({{slug}}),
// on retrouve chaque post pour generer l'URL et le titre automatiquement.
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const relatedPosts = data.related_posts
    .map((slug) => allPosts.find((p) => p.id === slug))
    .filter((p): p is (typeof allPosts)[number] => p !== undefined);
---

<Layout title={data.title}>
    <main>
        <article>
            <header>
                <h1 class="text-red-600">{data.title}</h1>
                <div class="meta">
                    <time datetime={data.publish_date.toISOString()}>
                        {data.publish_date.toLocaleDateString("fr-FR")}
                    </time>
                    <span class="category">{data.category}</span>
                    {data.tags.map((tag) => (
                        <span class="tag">#{tag}</span>
                    ))}
                </div>
                {data.description && (
                    <p class="description">{data.description}</p>
                )}
            </header>
            {data.cover && (
                <img
                    src={data.cover}
                    alt={`Couverture de ${data.title}`}
                    width="1200"
                    height="630"
                />
            )}

            {author && (
                <p class="author">
                    Par <strong>{author.data.name}</strong>
                    {author.data.bio && ` — ${author.data.bio}`}
                </p>
            )}

            <div class="content">
                <Content />
            </div>

            {relatedPosts.length > 0 && (
                <section>
                    <h2>Posts liés</h2>
                    <ul>
                        {relatedPosts.map((related) => (
                            <li>
                                <a href={`/posts/${related.id}/`}>
                                    {related.data.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            {data.links.length > 0 && (
                <section>
                    <h2>Liens</h2>
                    <ul>
                        {data.links.map((link) => (
                            <li>
                                <a href={link.url} rel="noopener">
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            {Object.keys(data.stats).length > 0 && (
                <section>
                    <h2>Stats</h2>
                    <ul>
                        {Object.entries(data.stats).map(([key, value]) => (
                            <li>
                                {key} : {value}
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            {data.snippet && (
                <section>
                    <h2>Snippet ({data.snippet.lang})</h2>
                    <pre><code>{data.snippet.code}</code></pre>
                </section>
            )}

            {(data.rating !== undefined ||
                data.accent_color ||
                data.location) && (
                <section class="details">
                    <h2>Details</h2>
                    <ul>
                        {data.rating !== undefined && (
                            <li>Note : {data.rating}/10</li>
                        )}
                        {data.rating_summary && <li>{data.rating_summary}</li>}
                        {data.accent_color && (
                            <li>
                                Couleur d'accent :{" "}
                                <span
                                    class="swatch"
                                    style={`background: ${data.accent_color}`}
                                />{" "}
                                {data.accent_color}
                            </li>
                        )}
                        {data.location && (
                            <li>
                                Localisation (GeoJSON) :{" "}
                                <code>{data.location}</code>
                            </li>
                        )}
                        {data.uuid && (
                            <li>
                                UUID : <code>{data.uuid}</code>
                            </li>
                        )}
                    </ul>
                </section>
            )}
        </article>

        <p>
            <a href="/">&larr; Tous les posts</a>
        </p>
    </main>
</Layout>

<style>
    main {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2rem 1rem;
    }
    .meta {
        display: flex;
        gap: 0.75rem;
        color: #64748b;
        font-size: 0.875rem;
    }
    .category {
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .description {
        color: #475569;
    }
    img {
        max-width: 100%;
        height: auto;
    }
    .swatch {
        display: inline-block;
        width: 1em;
        height: 1em;
        border: 1px solid #94a3b8;
        border-radius: 3px;
        vertical-align: middle;
    }
    pre {
        background: #0f172a;
        color: #e2e8f0;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
    }
</style>
