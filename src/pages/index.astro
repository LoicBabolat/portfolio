---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf(),
);
---

<Layout title="git-cms-template">
    <main>
        <div>
            <div class="box bg-green-600 size-12" id="green">
                Hey
            </div>
            <div class="box bg-blue-600 size-12" id="blue">
                Hey
            </div>
            <div class="box bg-orange-600 size-12" id="orange">
                Hey
            </div>
        </div>
        <h1>Posts</h1>
        <ul class="posts">
            {posts.map((post) => (
                <li>
                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                    <div class="meta">
                        <time datetime={post.data.publish_date.toISOString()}>
                            {post.data.publish_date.toLocaleDateString("fr-FR")}
                        </time>
                        <span class="category">{post.data.category}</span>
                        {post.data.tags.map((tag) => (
                            <span class="tag">#{tag}</span>
                        ))}
                    </div>
                    {post.data.description && <p>{post.data.description}</p>}
                </li>
            ))}
        </ul>
        <p>
            <a href="/admin/">Ouvrir Sveltia CMS</a>
        </p>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";

    gsap.to(".box", { rotation: 27, x: 100, duration: 1 });

    // And this is a Timeline, containing three sequenced tweens
    let tl = gsap.timeline();
    tl.to("#green", { duration: 1, x: 786 })
        .to("#blue", { duration: 2, x: 786 }, "<")
        .to("#orange", { duration: 1, x: 786 });
</script>

<style>
    .posts {
        list-style: none;
        padding: 0;
        max-width: 42rem;
        display: grid;
        gap: 1.5rem;
    }
    .meta {
        display: flex;
        gap: 0.75rem;
        color: #64748b;
        font-size: 0.875rem;
    }
    .category {
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
</style>
